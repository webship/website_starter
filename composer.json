        "drupal/coffee": "^2",
        "drupal/core": "^11.4 || ^12",
        "drupal/display_builder": "^1.0@beta",
        "drupal/drupal_cms_anti_spam": "^2",
        "drupal/drupal_cms_authentication": "^2",
        "drupal/drupal_cms_helper": "^2",
        "drupal/drupal_cms_seo_basic": "^2",
        "drupal/drupical": "^1",
        "drupal/gin": "^5",
        "drupal/gin_login": "^2.1.4",
        "drupal/project_browser": "^2.1-beta3",
        "drupal/sam": "^1.2",
        "drupal/tagify": "^1.2",
        "drupal/ui_icons": "^2.0",
        "drupal/ui_patterns": "^2.0.21",
